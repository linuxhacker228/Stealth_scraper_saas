// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ScrapeType {
  FAST
  STEALTH
}

model ScrapeTask {
  id        String        @id @default(uuid())
  url       String
  status    Status        @default(PENDING)
  type      ScrapeType    @default(FAST)
  options   Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  result    ScrapeResult?
}

model ScrapeResult {
  id           String     @id @default(uuid())
  taskId       String     @unique
  task         ScrapeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  statusCode   Int
  rawHtml      String?    @db.Text
  parsedData   Json?
  errorMessage String?
  createdAt    DateTime   @default(now())
}
